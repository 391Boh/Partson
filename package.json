{
  "name": "partson",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "clean:next": "node -e \"const fs=require('fs'); for (const dir of ['.next','.next-dev']) fs.rmSync(dir, { recursive: true, force: true })\"",
    "dev": "concurrently -k -n next,css \"NEXT_DIST_DIR=.next-dev next dev --turbopack\" \"npm run build:css:watch\"",
    "onec:tunnel": "bash scripts/onec-dev-tunnel.sh",
    "dev:clean": "npm run clean:next && npm run dev",
    "dev:webpack": "concurrently -k -n next,css \"NEXT_DIST_DIR=.next-dev next dev --webpack\" \"npm run build:css:watch\"",
    "dev:poll": "concurrently -k -n next,css \"NEXT_DIST_DIR=.next-dev FORCE_DEV_POLLING=1 WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --webpack\" \"npm run build:css:watch\"",
    "dev:all": "concurrently -k -n web,auth \"npm run dev\" \"node server.js\"",
    "dev:turbo": "npm run dev",
    "build:css": "node scripts/build-static-css.mjs --production",
    "build:css:watch": "node scripts/build-static-css.mjs --watch",
    "generate:group-previews": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/generate-group-previews.ts",
    "build": "npm run build:css && node scripts/build-site.mjs",
    "build:full": "npm run sync:catalog:full && npm run build",
    "generate:seo-counts": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/generate-seo-counts.ts",
    "generate:feed": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/generate-merchant-feed.ts",
    "generate:auto-model-sitemap": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/generate-auto-model-sitemap.ts",
    "warm:auto-model-breakdowns": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/warm-auto-model-breakdowns.ts",
    "warm:product-pages": "node scripts/warm-product-pages.mjs",
    "indexnow:submit": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/submit-indexnow.ts",
    "merchant:feed:update": "bash scripts/update-merchant-feed.sh",
    "merchant:cron:install": "bash scripts/install-merchant-feed-cron.sh",
    "merchant:cron:list": "crontab -l | grep -A2 -B2 'partson merchant feed' || true",
    "start": "next start",
    "start:web": "next start -p 3000",
    "start:auth": "node server.js",
    "start:prod": "concurrently -k -n web,auth \"next start -p 3000\" \"node server.js\"",
    "lint": "eslint .",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs --lines 100",
    "pm2:monit": "pm2 monit",
    "memory:monitor": "bash scripts/memory-monitor.sh",
    "generate:home-popular-icons": "tsx --require ./scripts/preload.cjs scripts/generate-home-popular-icons.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs unit",
    "test:browser": "node scripts/run-tests.mjs browser",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "test:all": "npm test && npm run test:browser",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "test:prepare": "node scripts/prepare-test-fixtures.mjs",
    "check": "npm run test:prepare && npm run typecheck && npm run lint && npm run test:all && npm run audit:production",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:catalog:full": "node scripts/sync-catalog.mjs --full",
    "prepare:catalog-inputs": "tsx --require ./scripts/preload.cjs --env-file=.env.local scripts/prepare-build-inputs.ts",
    "build:compile": "npm run build:css && node scripts/build-site.mjs --compile",
    "build:refresh": "npm run sync:catalog && npm run build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/postcss": "^4.1.7",
    "body-parser": "^2.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase": "^11.6.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.482.0",
    "next": "^16.4.3",
    "postcss": "^8.5.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "sharp": "^0.35.5",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "google-auth-library": "^10.7.0",
    "@google-cloud/storage": {
      "gaxios": "^7.1.5",
      "retry-request": "^8.0.3",
      "teeny-request": "^10.1.3"
    },
    "@grpc/grpc-js": "^1.14.5",
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    },
    "rimraf": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 115",
    "Safari >= 16.4",
    "iOS >= 16.4",
    "not op_mini all"
  ]
}
