rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role-based admin check (see app/api/_lib/admin-auth.ts for the server-side
    // twin). NOTE: this only covers admins promoted via the Users tab (role:
    // "admin" on their users/{uid} doc) — it cannot see the server-only
    // NEXT_PUBLIC_ADMIN_EMAILS bootstrap list, since rules have no env access.
    // An env-listed admin who has never been promoted will be denied here.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── orders ────────────────────────────────────────────────────────────────
    // Guests and authenticated users may create orders.
    // Only the authenticated owner can read their own orders (matched by uid field).
    // Updates and deletes are blocked on the client; use Firebase Admin SDK server-side.
    match /orders/{orderId} {
      allow create: if true;
      allow read:   if isOwner(resource.data.uid);
      allow update, delete: if false;
    }

    // ── messages (chat) ───────────────────────────────────────────────────────
    // Anyone may create or read messages.
    //
    // TRADE-OFF: TelegramChat stores a localStorage UUID (user_<uuid>) as userId,
    // not a Firebase Auth UID. Ownership cannot be verified by rules until the
    // component is migrated to use Firebase Auth. Until then, all messages are
    // publicly readable by anyone who can construct the query.
    //
    // Deletes are blocked. Updates are restricted to read-receipt flags only —
    // textRead (user marks manager messages read) and readByAdmin (admin marks
    // user messages read). No other field may be changed by the client.
    //
    // TODO: Migrate TelegramChat to call signInAnonymously and store
    //       request.auth.uid as userId, then tighten read to isOwner(resource.data.userId).
    match /messages/{messageId} {
      allow create: if true;
      allow read:   if true;
      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['textRead', 'readByAdmin']);
      allow delete: if false;
    }

    // ── chatPresence ──────────────────────────────────────────────────────────
    // Admin panel writes its sessionId to chatPresence/<userId> to signal that
    // a manager is viewing that user's chat. TelegramChat reads this document to
    // show a "manager is online" indicator. Anyone may read and write so that
    // unauthenticated users and admin can participate. Deletes are blocked.
    match /chatPresence/{userId} {
      allow read:   if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── zvyaz (call-back requests) ────────────────────────────────────────────
    // Create-only. No client-side reads, updates, or deletes.
    // Admin access goes through Firebase Admin SDK server-side.
    match /zvyaz/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Each user can read and write only their own profile document.
    //
    // TRADE-OFF: Phone uniqueness checks in Register.tsx / AuthForm.tsx /
    // AccountInfo.tsx query other users' documents, which this rule blocks.
    // Those queries will silently return zero results, disabling duplicate-phone
    // detection. Move that check to a server API route using the Admin SDK.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── productGallery (extra product photos, separate from the 1C photo) ────
    // Writes only happen server-side via the Admin SDK (app/api/product-gallery
    // route, already admin-gated there) — the client is read-only.
    match /productGallery/{code}/images/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // ── messageTemplates (admin canned replies) ──────────────────────────────
    match /messageTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ── chatSettings (e.g. chatSettings/autoReply) ───────────────────────────
    // Read is public so the "is auto-reply enabled" check could be done
    // client-side too if ever needed; only admins may change settings.
    match /chatSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
