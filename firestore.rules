rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role-based admin check (see app/api/_lib/admin-auth.ts for the server-side
    // twin). NOTE: this only covers admins promoted via the Users tab (role:
    // "admin" on their users/{uid} doc) — it cannot see the server-only
    // NEXT_PUBLIC_ADMIN_EMAILS bootstrap list, since rules have no env access.
    // An env-listed admin who has never been promoted will be denied here.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── orders ────────────────────────────────────────────────────────────────
    // Guests and authenticated users may create orders.
    // Owners read their orders; role-based admins read orders for fulfillment.
    // Updates and deletes are blocked on the client; use Firebase Admin SDK server-side.
    match /orders/{orderId} {
      allow create: if true;
      allow read:   if isOwner(resource.data.uid) || isAdmin();
      allow update, delete: if false;
    }

    // ── messages (chat) ───────────────────────────────────────────────────────
    // A thread belongs to the visitor's Firebase uid (27.11.2026): the account
    // uid, or an anonymous uid the site chat signs a guest in with
    // (app/lib/chat-identity.ts). Earlier threads under localStorage ids were
    // moved onto uids by /api/chat/claim. Visitors read and write only their
    // own thread; role-based admins read and manage all of them. Manager
    // replies and auto-replies are written server-side (Admin SDK).
    match /messages/{messageId} {
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
                       (isSignedIn() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.sender == 'user');
      // Owners may only mark manager messages read.
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['textRead']));
      allow delete: if isAdmin();
    }

    // ── chatPresence ──────────────────────────────────────────────────────────
    // chatPresence/<chat uid>: the visitor's online flag (written by the
    // site) and the manager-in-chat sessions (written by the admin panel).
    // A visitor reads and writes only their own doc, and only the two
    // presence fields; admins read and write all.
    match /chatPresence/{userId} {
      allow read:   if isAdmin() || isOwner(userId);
      allow create: if isAdmin() ||
                       (isOwner(userId) &&
                        request.resource.data.keys().hasOnly(['userIsOnline', 'userLastSeenAt']));
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userIsOnline', 'userLastSeenAt']));
      allow delete: if isAdmin();
    }

    // ── zvyaz (call-back requests) ────────────────────────────────────────────
    // Create-only. No client-side reads, updates, or deletes.
    // Admin access goes through Firebase Admin SDK server-side.
    match /zvyaz/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Each user can read and write only their own profile document. Admins may
    // additionally read (but not write — role/partner changes go through the
    // Admin-SDK-gated app/api/admin/users routes) any profile, since the
    // admin panel's Users tab lists the whole collection via a plain
    // onSnapshot(collection(db, 'users')) listener: without this, Firestore
    // rejects that unfiltered query outright for every caller (a `list`
    // query is only allowed when the rule can be proven true for every
    // possible result from the query shape alone, which isOwner() — a
    // per-document check against the caller's own uid — can never do for an
    // unconstrained collection query), leaving the tab permanently empty.
    //
    // TRADE-OFF: Phone uniqueness checks in Register.tsx / AuthForm.tsx /
    // AccountInfo.tsx query other users' documents, which this rule blocks.
    // Those queries will silently return zero results, disabling duplicate-phone
    // detection. Move that check to a server API route using the Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Avatar access and achievement thresholds are verified by the
      // profile-appearance API. Ordinary profile edits stay client-side.
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny(['avatar', 'avatarFrame', 'profileBackground', 'role']);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatar', 'avatarFrame', 'profileBackground', 'role']);
      allow delete: if isOwner(userId);
    }

    // ── productGallery (extra product photos, separate from the 1C photo) ────
    // Writes only happen server-side via the Admin SDK (app/api/product-gallery
    // route, already admin-gated there) — the client is read-only.
    match /productGallery/{code}/images/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // ── messageTemplates (admin canned replies) ──────────────────────────────
    match /messageTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ── chatSettings (e.g. chatSettings/autoReply) ───────────────────────────
    // Read is public so the "is auto-reply enabled" check could be done
    // client-side too if ever needed; only admins may change settings.
    match /chatSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
